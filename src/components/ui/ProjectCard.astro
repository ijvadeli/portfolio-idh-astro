---
interface Props {
    title: string;
    info: string;
    image: string;
    link: string;
}

const { title, info, image, link } = Astro.props;
---

<div class="card bg-base-200 w-full h-90">
    <figure class="h-48 w-full">
        <img
            src={image}
            alt={`Product image or screenshot of ${title}`}
            class="h-full w-full object-cover"
        />
    </figure>

    <div class="card-body">
        <h2 class="card-title text-3xl">{title}</h2>
        <p class="leading-relaxed text-base">{info}</p>

        <div class="card-actions">
            <a class="btn btn-primary" href={link} target="_blank">
                Link
            </a>
        </div>
    </div>
</div>
