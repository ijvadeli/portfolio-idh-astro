---
interface Props {
    title: string;
    info: string;
    image: string;
    link: string;
}

const { title, info, image, link } = Astro.props;
---

<div class="card bg-base-200 w-full shadow-sm">
    <figure>
        <img src={image} alt=`Product image or screenshot of ${title}` />
    </figure>
    <div class="card-body">
        <h2 class="card-title text-3xl">{title}</h2>
        <p>
            {info}
        </p>
        <div class="card-actions justify-end">
            <a class="btn btn-primary" href={link} target="_blank">Link</a>
        </div>
    </div>
</div>
