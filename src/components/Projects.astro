---
import ProjectCard from "./ui/ProjectCard.astro";
import Skills from "./ui/Skills.astro";
---

<section id="projects" class="w-full scroll-mt-24">
    <div class="my-12">
        <h1 class="text-5xl font-semibold">Projects</h1>
        <p class="pt-4 text-lg">
            Some projects to showcase my skills and what I'm proud of.
        </p>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <ProjectCard
            title="Kivo"
            info="Simple text editor built in Tauri with React & TypeScript."
            image="/KivoBanner.webp"
            link="https://github.com/ijvadeli/Kivo"
        />

        <ProjectCard
            title="Linux Dotfiles"
            info="My shared configurations for my linux apps/window managers."
            image="/linux-dotfiles.webp"
            link="https://github.com/ijvadeli/dotfiles-arch-sway"
        />

        <ProjectCard
            title="Snelvoedsel"
            info="Small project I'm working on with a friend. (WIP)"
            image="/Snelvoedsel.webp"
            link="https://www.snelvoedsel.nl/"
        />

        <ProjectCard
            title="Portfolio"
            info="The website you are on right now, full source code."
            image="/portfolio-header.webp"
            link="https://github.com/ijvadeli/portfolio-idh-astro"
        />
    </div>
    <Skills />
</section>
