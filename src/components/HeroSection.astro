---
import { Image } from "astro:assets";
import asioclamator from "../assets/asioclamator.webp";
---

<header id="home" class="hero min-h-180 scroll-mt-24">
    <div class="hero-content p-0 flex-col lg:flex-row-reverse">
        <Image
            alt="Tailwind CSS hero component"
            src={asioclamator}
            class="max-w-xs"
            width={250}
            height={250}
        />
        <div>
            <h1 class="text-6xl font-semibold">Hi! I'm IJsbrand.</h1>
            <p class="text-lg py-6 leading-relaxed">
                Software Developer & Designer interested in new technologies,
                mostly React frameworks.
            </p>
            <div class="inline-flex gap-2">
                <a href="#projects" class="btn btn-primary">
                    View Projects
                </a>
                <a href="#contact" class="btn btn-ghost">
                    Get in touch
                </a>
            </div>
        </div>
    </div>
</header>
