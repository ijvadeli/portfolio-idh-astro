---
import { Image } from "astro:assets";
import asioclamator from "../assets/asioclamator.webp";
---

<header class="hero bg-base-200 min-h-180">
    <div class="hero-content flex-col lg:flex-row-reverse">
        <Image
            alt="Asio Clamator owl profile picture"
            src={asioclamator}
            class="max-w-xs rounded-lg shadow-2xl"
            width={250}
            height={250}
        />
        <div>
            <h1 class="text-5xl font-semibold">Hi! I'm IJsbrand.</h1>
            <p class="py-6">Software Developer & Designer working @ home.</p>
            <button class="btn btn-primary">Contact Me</button>
        </div>
    </div>
</header>
