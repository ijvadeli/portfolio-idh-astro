---
import { Image } from "astro:assets";
import asioclamator from "../assets/asioclamator.webp";
---

<header class="min-h-[calc(100vh-4rem)] bg-base-100">
    <div
        class="mx-auto flex min-h-[calc(100vh-4rem)] max-w-6xl items-center
               px-6 py-20 lg:px-12"
    >
        <div
            class="grid w-full items-center gap-16
                   lg:grid-cols-[1fr_auto]"
        >
            <!-- Copy -->
            <div class="max-w-2xl">
                <h1
                    class="text-6xl font-semibold tracking-[-0.04em]
                           text-base-content sm:text-7xl lg:text-8xl"
                >
                    Hi! I'm IJsbrand.
                </h1>

                <p
                    class="mt-8 max-w-xl text-xl leading-relaxed
             sm:text-2xl"
                >
                    I build thoughtful software and design digital experiences
                    that are simple to use.
                </p>

                <div class="mt-10 flex flex-wrap items-center gap-4">
                    <a href="#contact" class="btn btn-primary px-6">
                        Let's talk
                    </a>

                    <a
                        href="#work"
                        class="btn btn-ghost px-6 text-base-content/70"
                    >
                        See my work
                        <span aria-hidden="true"></span>
                    </a>
                </div>
            </div>

            <!-- Image -->
            <div class="relative">
                <div class="relative flex h-64 w-64 sm:h-80 sm:w-80 items-center justify-center">
                    <Image
                        alt="Asio Clamator owl profile picture"
                        src={asioclamator}
                        fetchpriority="high"
                        width={300}
                        height={300}
                        class="h-full w-full object-cover"
                    />
                </div>
            </div>
        </div>
    </div>
</header>
