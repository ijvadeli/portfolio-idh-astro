---
import { Image } from "astro:assets";
import asioclamator from "../assets/asioclamator.webp";
---

<header class="hero bg-base-200 min-h-180">
    <div class="hero-content flex-col lg:flex-row-reverse">
        <Image
            alt="Tailwind CSS hero component"
            src={asioclamator}
            class="max-w-xs rounded-lg shadow-lg"
            width={250}
            height={250}
        />
        <div>
            <h1 class="text-5xl font-semibold">Hi! I'm IJsbrand.</h1>
            <p class="text-2xl py-6">
                Software Developer & Designer working @ home.
            </p>
            <button class="btn btn-primary">View Projects</button>
        </div>
    </div>
</header>
